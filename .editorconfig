root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# YAML requires spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Unity serializes its own files; leave them in Unity's format
[unity/**.{unity,prefab,asset,mat,anim,controller,meta}]
indent_style = space
indent_size = 2

[unity/Packages/*.json]
indent_style = space
indent_size = 2
