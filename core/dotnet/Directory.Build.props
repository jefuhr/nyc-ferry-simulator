<Project>
	<PropertyGroup>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<!-- Path to the Unity local package that holds the shared core source. -->
		<FerrySimCoreSource>$(MSBuildThisFileDirectory)../FerrySim.Core/</FerrySimCoreSource>
	</PropertyGroup>
</Project>
