/* Wheelhouse day palette: opaque dark console, bright numerals, muted blue-grey bezels. */
.input-calibration {
	flex-grow: 1;
	background-color: #0e1318;
	color: #f2f5f7;
	padding: 12px 18px;
	font-size: 14px;
}
.cal-eyebrow { color: #a2b1be; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; margin-top: 4px; margin-bottom: 4px; }
.cal-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 3px; }
.cal-subtitle { color: #c7d2dc; font-size: 13px; margin-bottom: 8px; }
.cal-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.cal-sidebar { width: 274px; padding: 10px 16px 10px 0; margin-right: 18px; border-right-width: 1px; border-right-color: #2c3743; }
.cal-devices { max-height: 150px; }
.cal-device { min-height: 52px; -unity-text-align: middle-left; white-space: normal; margin: 2px 0 6px 0; }
.cal-main { flex-grow: 1; min-width: 0; }
.cal-device-title { font-size: 20px; -unity-font-style: bold; }
.cal-note { color: #a2b1be; white-space: normal; font-size: 12px; margin: 3px 0 6px 0; }
.cal-path { color: #a2b1be; font-size: 10px; white-space: normal; margin-top: 16px; }
.cal-row { flex-direction: row; flex-wrap: wrap; margin: 4px 0; }
.cal-row > .unity-base-field { flex-grow: 1; min-width: 210px; margin-right: 12px; }
.input-calibration .unity-base-field { margin: 4px 0; }
.input-calibration .unity-base-field__label { min-width: 150px; color: #c7d2dc; }
.input-calibration .unity-toggle__label { min-width: 110px; }
.input-calibration .unity-base-field__input { background-color: #25303b; color: #f2f5f7; min-height: 22px; }
.cal-steps { flex-direction: row; margin: 8px 0; }
.cal-step { flex-grow: 1; flex-basis: 0; padding: 7px 8px; margin-right: 6px; background-color: #161d24; border-width: 1px; border-color: #2c3743; border-radius: 5px; font-size: 11px; color: #a2b1be; }
.cal-step-active { border-color: #5cc8ff; background-color: #203341; color: #f2f5f7; }
.cal-step-done { border-color: #3cd483; color: #3cd483; }
.input-calibration Button { background-color: #25303b; color: #f2f5f7; border-width: 1px; border-color: #415161; border-radius: 4px; padding: 6px 10px; font-size: 12px; }
.input-calibration Button:hover { background-color: #344556; }
.input-calibration Button:disabled { color: #71808d; border-color: #2c3743; background-color: #161d24; }
.input-calibration .cal-primary { background-color: #315870; border-color: #5cc8ff; }
.cal-buttons Button { margin: 2px 6px 2px 0; }
.cal-live { flex-direction: row; flex-wrap: wrap; background-color: #161d24; padding: 6px 8px; border-radius: 5px; }
.cal-axis { min-width: 200px; color: #c7d2dc; margin: 2px 12px 2px 0; font-size: 13px; }
.cal-output { flex-grow: 1; flex-basis: 0; padding: 7px 10px; margin-right: 8px; background-color: #161d24; border-width: 1px; border-color: #2c3743; border-radius: 5px; }
.cal-number { font-size: 24px; -unity-font-style: bold; }
.cal-outputs .unity-progress-bar { margin-top: 5px; height: 12px; }
.cal-outputs .unity-progress-bar__progress { background-color: #5cc8ff; }
.cal-outputs .unity-progress-bar__background { background-color: #2c3743; }
.cal-status { color: #5cc8ff; white-space: normal; font-size: 13px; margin: 8px 0 4px 0; }

.cal-sidebar .cal-output { flex-grow: 0; flex-basis: auto; min-height: 78px; margin: 0 0 6px 0; padding: 4px 8px; }
.cal-sidebar .cal-number { font-size: 22px; }
